{
  "name": "@bh/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./styles/index.css"
  },
  "scripts": {
    "check:circular": "bh-madge src",
    "lint": "bh-lint src/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:build": "node scripts/generators/build-tokens.ts && node scripts/extract-safelist.mjs",
    "tokens:verify": "node scripts/generators/build-tokens.ts && node scripts/extract-safelist.mjs && git diff --exit-code -- styles/generated src/style/generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bh/form": "workspace:*",
    "@bh/table": "workspace:*",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@bh/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "sideEffects": false
}
