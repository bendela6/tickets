{
  "extends": "@bh/config/tsconfig/react",
  "compilerOptions": {
    "noEmit": true,
    // vite/client because @bh/ui's own sources, which tsc follows through the
    // import, use import.meta.glob and ?raw imports.
    "types": ["vitest/globals", "node", "vite/client", "@testing-library/jest-dom/vitest"],
    "paths": {
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src"]
}
