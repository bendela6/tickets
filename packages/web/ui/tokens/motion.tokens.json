{
  "duration": {
    "120": { "$type": "duration", "$value": "120ms" },
    "200": { "$type": "duration", "$value": "200ms" },
    "320": { "$type": "duration", "$value": "320ms" }
  },
  "ease": {
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "animate": {
    "spin": {
      "$type": "string",
      "$value": "ai-spin 1.4s linear infinite"
    },
    "pulse": {
      "$type": "string",
      "$value": "ai-pulse 1.8s ease-out infinite"
    }
  },
  "transition": {
    "paint": {
      "$type": "string",
      "$value": "opacity, border-color, background-color, box-shadow"
    }
  }
}
