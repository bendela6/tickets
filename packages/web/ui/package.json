{
  "name": "@tickets/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    "./cn": "./src/style/cn/index.ts",
    "./variants": "./src/style/variants/index.ts",
    "./runtime-style": "./src/style/runtime-style/index.ts",
    "./colors": "./src/foundation/colors/index.ts",
    "./tones": "./src/style/tones/index.ts",
    "./icon": "./src/components/icon/index.ts",
    "./pill": "./src/components/pill/index.ts",
    "./tabs": "./src/components/tabs/index.ts",
    "./segmented-control": "./src/components/segmented-control/index.ts",
    "./meter": "./src/components/meter/index.ts",
    "./screen-state": "./src/components/screen-state/index.ts",
    "./spinner": "./src/components/spinner/index.ts",
    "./copy-button": "./src/components/copy-button/index.ts",
    "./dialog-footer": "./src/components/dialog-footer/index.ts",
    "./rail-label": "./src/components/rail-label/index.ts",
    "./section-header": "./src/components/section-header/index.ts",
    "./gallery": "./src/gallery/index.ts",
    "./gallery/demos": "./src/gallery/demos.ts",
    "./gallery/demo-sources": "./src/gallery/demo-sources.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:lint": "node scripts/scan-hardcoded-values.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "tokens:verify": "node scripts/build-tokens.mjs && git diff --exit-code src/tokens/tokens.css src/style/tones/tones.generated.ts && node scripts/scan-hardcoded-values.mjs && node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0",
    "react": "^19.0.0",
    "tailwindcss": "^4.3.2"
  }
}
