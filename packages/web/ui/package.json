{
  "name": "@tickets/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:lint": "node scripts/scan-hardcoded-values.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "tokens:verify": "node scripts/build-tokens.mjs && git diff --exit-code src/tokens/tokens.css src/style/tones/tones.generated.ts && node scripts/scan-hardcoded-values.mjs && node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0",
    "react": "^19.0.0",
    "tailwindcss": "^4.3.2"
  }
}
