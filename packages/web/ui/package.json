{
  "name": "@tickets/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node scripts/generators/build-tokens.ts && node scripts/extract-safelist.mjs",
    "tokens:verify": "node scripts/generators/build-tokens.ts && node scripts/extract-safelist.mjs && git diff --exit-code src/tokens/tokens.css src/tokens/safelist.generated.css src/style/tones/tones.generated.ts"
  },
  "dependencies": {
    "@tickets/form": "workspace:*",
    "@tickets/table": "workspace:*",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0",
    "react": "^19.0.0",
    "tailwindcss": "^4.3.2"
  }
}
