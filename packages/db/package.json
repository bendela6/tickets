{
  "name": "@tickets/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:check-schema": "tsx src/schema-guard.ts",
    "db:seed": "tsx src/run-seed.ts",
    "db:import": "tsx src/import/run-import.ts",
    "db:verify-import": "tsx src/import/run-verify.ts",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "db:restore-legacy": "bash -c 'set -e; docker exec tickets-postgres-1 psql -U postgres -c \"DROP DATABASE IF EXISTS tickets_legacy;\"; docker exec tickets-postgres-1 psql -U postgres -c \"CREATE DATABASE tickets_legacy;\"; docker exec -i tickets-postgres-1 pg_restore -U postgres -d tickets_legacy --no-owner < \"${LEGACY_DUMP:?set LEGACY_DUMP to the backup dump path}\"'",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
