POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5532
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# tickets (prod) | tickets_dev (local dev)
POSTGRES_DATABASE=tickets_dev
API_PORT=4600
WEB_PORT=4610
# Directory-browser allow-list for /api/workdirs/dirs: comma-separated
# absolute paths (not `:`, so Windows drive letters survive). Defaults to
# the running user's home dir if unset.
WORKDIR_ROOTS=/home/me
