{
  "name": "tickets",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "repository": "github:bendela6/tickets",
  "scripts": {
    "build": "turbo build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @tickets/db db:migrate",
    "db:seed": "pnpm --filter @tickets/db db:seed",
    "db:studio": "pnpm --filter @tickets/db db:studio",
    "dev": "mprocs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tasks": "node scripts/tasks-view.mjs",
    "tasks:check": "node scripts/tasks-check.mjs",
    "test:tasks": "node --test scripts/tasks-*.test.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prepare": "bh-hooks",
    "release": "bh-release"
  },
  "devDependencies": {
    "@bh/config": "workspace:*",
    "mprocs": "^0.9.6",
    "prettier": "^3.6.2",
    "turbo": "~2.9.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "release": {
    "services": [
      "apps/api",
      "apps/mcp",
      "apps/web"
    ],
    "vendored": [
      "packages/bh/*"
    ],
    "copies": {
      "bh": "0.9.6"
    }
  }
}
